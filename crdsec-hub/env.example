# Copy this file to .env and adjust as needed - docker compose reads .env
# automatically from this directory, and crdsec-hub.sh sources it too
# so its messages print real, usable values instead of placeholders.

# Hostname or IP remote crdsectl agents should use to reach this hub.
# "localhost" only works for testing on the same machine - set this to
# a real, externally-reachable hostname or IP for actual remote agents.
HUB_HOST=localhost

# Host port nginx publishes for HTTPS. HTTPS-only by design - there is no
# HTTP port; nginx does not listen on 80 at all, nothing to redirect.
NGINX_HTTPS_PORT=8443

# Space-separated list of CrowdSec collections to install at startup.
COLLECTIONS=crowdsecurity/linux

# Pin a specific crowdsecurity/crowdsec image tag instead of "latest".
IMAGE_TAG=latest

# Validity period (in days) for gen-cert.sh's certs. CA_DAYS only
# matters the first time (the CA is reused on later runs, never
# regenerated); LEAF_DAYS applies every run, since the leaf is always
# regenerated fresh.
CA_DAYS=3650
LEAF_DAYS=365
