# Runtime state: decision DB, registered machine/bouncer credentials.
# "data/*"/"config/*" (not "data/"/"config/") so the directories themselves
# aren't excluded - see the tls/ note below for why that matters for the
# README.md exceptions.
data/*
!data/README.md
config/*
!config/README.md

# TLS private keys and certificates - never commit these, including the
# CA private key (tls/ca.key), which also lives here. "tls/*" (not "tls/")
# so the directory itself isn't excluded - a parent-excluded directory
# can't have any of its files re-included, which the README.md exception
# below needs.
tls/*
!tls/README.md

# Local overrides - copy env.example to .env instead of committing it.
.env

*.swp
